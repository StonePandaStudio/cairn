{
  "$comment": "Workspace for `cairn doctor`. Repos listed here are compared against each other. Per-repo settings (tracker, stack, agent names) belong in each repo's own cairn.config.json — the inline `vars` blocks below are a fallback used only until a repo has been through `cairn init`.",

  "repos": [
    {
      "name": "glossr-api",
      "path": "D:/projects/glossr/glossr-api",
      "stack": ["nestjs", "typeorm"],
      "vars": {
        "jiraKey": "GLO",
        "storyType": "Story",
        "subtaskType": "Sub-task",
        "architectAgent": "NodeArchitectAgent",
        "architectDoc": "ai/agents/node-architect.md",
        "developerAgent": "NodeDeveloperAgent",
        "developerDoc": "ai/agents/node-developer.md",
        "reviewerAgent": "NodeReviewerAgent",
        "reviewerDoc": "ai/agents/node-reviewer.md",
        "qaArchitectAgent": "NodeQAArchitectAgent",
        "qaArchitectDoc": "ai/agents/node-qa-architect.md",
        "qaDeveloperAgent": "NodeQADeveloperAgent",
        "qaDeveloperDoc": "ai/agents/node-qa-developer.md",
        "qaOrchestratorAgent": "NodeQAOrchestratorAgent",
        "qaOrchestratorDoc": "ai/agents/node-qa-orchestrator.md"
      }
    },
    {
      "name": "snap-backend",
      "path": "D:/projects/snap-proof/backend",
      "stack": ["nestjs", "typeorm"],
      "vars": {
        "jiraKey": "PROOF",
        "storyType": "Task",
        "subtaskType": "Sub-task",
        "architectAgent": "NodeArchitectAgent",
        "architectDoc": "ai/agents/node-architect.md",
        "developerAgent": "NodeDeveloperAgent",
        "developerDoc": "ai/agents/node-developer.md",
        "reviewerAgent": "NodeReviewerAgent",
        "reviewerDoc": "ai/agents/node-reviewer.md",
        "qaArchitectAgent": "NodeQAArchitectAgent",
        "qaArchitectDoc": "ai/agents/node-qa-architect.md",
        "qaDeveloperAgent": "NodeQADeveloperAgent",
        "qaDeveloperDoc": "ai/agents/node-qa-developer.md",
        "qaOrchestratorAgent": "NodeQAOrchestratorAgent",
        "qaOrchestratorDoc": "ai/agents/node-qa-orchestrator.md"
      }
    },
    {
      "name": "snap-frontend",
      "path": "D:/projects/snap-proof/frontend",
      "stack": "angular",
      "vars": {
        "jiraKey": "PROOF",
        "storyType": "Task",
        "subtaskType": "Sub-task",
        "architectAgent": "AngularArchitectAgent",
        "architectDoc": "ai/agents/architect-lead.md",
        "developerAgent": "AngularDeveloperAgent",
        "developerDoc": "ai/agents/angular-developer.md",
        "reviewerAgent": "AngularReviewerAgent",
        "reviewerDoc": "ai/agents/angular-reviewer.md",
        "qaDeveloperAgent": "AngularQAAgent",
        "qaDeveloperDoc": "ai/agents/angular-qa.md"
      }
    },
    {
      "name": "glossr-frontend",
      "path": "D:/projects/glossr/glossr-frontend",
      "stack": "angular",
      "vars": {
        "jiraKey": "GLO",
        "storyType": "Story",
        "subtaskType": "Sub-task",
        "architectAgent": "AngularArchitectAgent",
        "architectDoc": "ai/agents/architect-lead.md",
        "developerAgent": "AngularDeveloperAgent",
        "developerDoc": "ai/agents/angular-developer.md",
        "reviewerAgent": "AngularReviewerAgent",
        "reviewerDoc": "ai/agents/angular-reviewer.md"
      }
    },
    {
      "$comment": "No issue tracker and no ai/scripts/. It is in the workspace as the stack-agnostic test case: rules that require a tracker skip it, and its renamed command stubs are folded onto the canonical names via pathAliases rather than reported as gaps.",
      "name": "glossr-cli",
      "path": "D:/projects/glossr/glossr-cli",
      "stack": "cli",
      "pathAliases": {
        ".claude/commands/execute-tests.md": ".claude/commands/execute-test-plan.md",
        ".claude/commands/review-code.md": ".claude/commands/code-review.md"
      },
      "vars": {
        "jiraKey": "GLO",
        "storyType": "Story",
        "subtaskType": "Sub-task",
        "architectAgent": "CliArchitectAgent",
        "architectDoc": "ai/agents/cli-architect.md",
        "developerAgent": "CliDeveloperAgent",
        "developerDoc": "ai/agents/cli-developer.md",
        "reviewerAgent": "CliReviewerAgent",
        "reviewerDoc": "ai/agents/cli-node-reviewer.md",
        "qaArchitectAgent": "CliQAArchitectAgent",
        "qaArchitectDoc": "ai/agents/cli-qa-architect.md",
        "qaDeveloperAgent": "CliQADeveloperAgent",
        "qaDeveloperDoc": "ai/agents/cli-qa-developer.md"
      }
    }
  ],

  "shared": [
    {
      "glob": ".claude/commands/*.md",
      "cohort": "all",
      "note": "Command stubs — should be identical modulo vars. Rendered from workflow config in v2."
    },
    {
      "glob": "ai/scripts/*.js",
      "cohort": "all",
      "requires": { "tracker": true },
      "note": "Replaced by the vendored cairn shim — this rule now guards against a copy creeping back."
    },
    {
      "glob": "ai/*.md",
      "cohort": "all",
      "exclude": [
        "ai/PROGRESS.md",
        "ai/PROJECT_SUMMARY.md",
        "ai/STATS.md",
        "ai/DISTRIBUTED_SETUP.md",
        "ai/INITIAL_PROMPT.md",
        "ai/PRE_INITIAL_APP_DESIGN.md"
      ],
      "note": "AGENTS.md / JIRA_MARKUP.md / WORKFLOW.md. INITIAL_PROMPT.md is excluded on purpose: four variants, 0% shared — it is a per-project document, not a drifted template."
    },
    {
      "glob": "ai/agents/*.md",
      "cohort": "stack",
      "note": "Role contract is shareable within a stack; persona body is not."
    },
    {
      "glob": "ai/infrastructure/code-guidelines.md",
      "cohort": "stack",
      "note": "Project-owned. Compared for visibility only — cairn will never generate this."
    },
    {
      "glob": "ai/infrastructure/project-structure.md",
      "cohort": "stack",
      "note": "Project-owned, same as code-guidelines.md."
    }
  ],

  "normalize": {
    "trailingWhitespace": true,
    "jiraKeys": true,
    "repoPaths": true,
    "issueTypes": false,
    "$comment": "vars listed here are folded to {{placeholders}} before comparing, so stack-specific naming stops counting as drift. What survives folding is the real divergence.",
    "vars": [
      "architectAgent",
      "architectDoc",
      "developerAgent",
      "developerDoc",
      "reviewerAgent",
      "reviewerDoc",
      "qaArchitectAgent",
      "qaArchitectDoc",
      "qaDeveloperAgent",
      "qaDeveloperDoc",
      "qaOrchestratorAgent",
      "qaOrchestratorDoc"
    ]
  }
}
